def _resolve_adapter(adapter_name, *, local_files_only=False):
    path = Path(adapter_name)
    if path.is_dir(): return str(path)
    local_files_only = local_files_only or _offline_mode() or os.environ.get("SPECTER2_LOCAL_FILES_ONLY","").lower() in ...
    hub = None
    try:
        from huggingface_hub import snapshot_download
    except Exception as exc:
        logger.warning(...)
    if hub is not None:
        try:
            return snapshot_download(adapter_name, local_files_only=True)
        except Exception as exc:
            logger.debug(...)
        for root in _local_hub_roots():
            snapshot = _adapter_snapshot_in_cached_hub(adapter_name, root)
            if snapshot:
                logger.info("Resolved adapter %s from repo cache %s", ...)
                return str(snapshot)
        if not local_files_only:
            try:
                return snapshot_download(adapter_name, allow_patterns=[...])
            except Exception as exc:
                logger.warning(...)
        else:
            logger.warning("Adapter %s not found in local caches; offline/local-only mode is set", ...)
    return adapter_name
```

