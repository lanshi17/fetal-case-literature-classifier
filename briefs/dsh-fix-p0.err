def _local_hub_roots() -> list[Path]:
    roots: list[Path] = []
    explicit = os.environ.get("HF_HUB_CACHE")
    if explicit:
        roots.append(Path(explicit).expanduser())
    hf_home = os.environ.get("HF_HOME")
    if hf_home:
        roots.append(Path(hf_home).expanduser()/"hub")
    roots.extend([PROJECT_HF_HUB, Path.home()/".cache"/"huggingface"/"hub"])
    unique=[]
    seen=set()
    for r in roots:
        key = str(r)
        if key not in seen:
            seen.add(key); unique.append(r)
    return unique
```
If HF_HOME is project, PROJECT_HF_HUB duplicate. Good.

`_configure_hf_cache`:

```
def _configure_hf_cache() -> None:
    default_home = Path.home() / ".cache" / "huggingface"
    requested = os.environ.get("HF_HOME")
    home = Path(requested).expanduser() if requested else default_home
    explicit_hub = os.environ.get("HF_HUB_CACHE")
    selected_hub = Path(explicit_hub).expanduser() if explicit_hub else home/"hub"

    project_has_adapter = _adapter_snapshot_in_cached_hub(DEFAULT_ADAPTER, PROJECT_HF_HUB) is not None
    selected_has_adapter = _adapter_snapshot_in_cached_hub(DEFAULT_ADAPTER, selected_hub) is not None

    # A user-provided cache wins when usable; otherwise prefer the repo cache
    # when it is the only place the adapter exists, then any writable cache.
    if (requested or explicit_hub) and _writable_cache(home) and (selected_has_adapter or not project_has_adapter):
        chosen = home
    elif project_has_adapter and _writable_cache(PROJECT_HF_HOME):
        chosen = PROJECT_HF_HOME
    elif _writable_cache(home):
        chosen = home
    else:
        chosen = PROJECT_HF_HOME
    ...
```

