def bootstrap_ci(y, scores, groups, threshold, n=2000, seed=42, alpha=0.05):
  rng = np.random.default_rng(seed)
  unique groups, index arrays
  for b:
    sampled = rng.choice(unique_groups, size=n_groups, replace=True)
    idx = np.concatenate([group_idx[g] for g in sampled])
    compute metrics (recall, precision, f1, f2, ap, predicted_positive, tp/fp/fn/tn)
  arrays; for each metric ignore nan; mean, median, low=percentile(2.5), high=97.5
```
